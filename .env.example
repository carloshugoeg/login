PORT=3000
DATABASE_PATH=./data/app.db
BCRYPT_ROUNDS=12

# Con esta URL se arma el enlace del correo. Si envías a otra persona,
# localhost NO le servirá: necesitas una URL pública (ver README).
APP_BASE_URL=http://localhost:3000

# console = imprime el correo en la terminal
# smtp    = lo envía de verdad
MAIL_TRANSPORT=console

# ---- Solo para MAIL_TRANSPORT=smtp ----
# Gmail: SMTP_PASSWORD es una CONTRASEÑA DE APLICACIÓN de 16 letras
# (myaccount.google.com/apppasswords), nunca la de tu cuenta.
# MAIL_FROM suele tener que coincidir con SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=
MAIL_FROM="Registro Lab <tu-correo@gmail.com>"
